{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Tool Category Schema",
  "description": "Schema for individual tool category JSON files (e.g., design.json)",
  "type": "object",
  "required": ["version", "category", "lastUpdated", "tools"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Version of the tool data"
    },
    "category": {
      "type": "string",
      "description": "ID of the category this file belongs to"
    },
    "lastUpdated": {
      "type": "string",
      "format": "date-time",
      "description": "Last update timestamp for this category's tools"
    },
    "tools": {
      "type": "array",
      "description": "List of tools in this category",
      "items": {
        "type": "object",
        "required": ["id", "name", "description", "url", "category", "subcategory", "tags", "isActive"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "officialUrl": { "type": "string", "format": "uri" },
          "documentationUrl": { "type": "string", "format": "uri" },
          "githubUrl": { "type": "string", "format": "uri" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "category": { "type": "string" },
          "subcategory": { "type": "string" },
          "language": { "type": "string" },
          "rating": { "type": "number", "minimum": 0, "maximum": 5 },
          "popularity": { "type": "string" },
          "learningCurve": { "type": "string" },
          "dateAdded": { "type": "string", "format": "date-time" },
          "lastUpdated": { "type": "string", "format": "date-time" },
          "recommendedBy": { "type": "string" },
          "notes": { "type": "string" },
          "useCases": { "type": "array", "items": { "type": "string" } },
          "alternatives": { "type": "array", "items": { "type": "string" } },
          "requirements": { "type": "object" },
          "isActive": { "type": "boolean" },
          "license": { "type": "string" },
          "company": { "type": "string" },
          "icon": { "type": "string", "format": "uri" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}